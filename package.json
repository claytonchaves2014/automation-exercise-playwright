{
  "name": "automacao-exercicio-playwright",
  "version": "1.0.0",
  "private": true,
  "description": "Testes automatizados de API e E2E com Playwright e Cucumber",
  "scripts": {
    "test": "cucumber-js",
    "test:api": "cucumber-js --tags @api",
    "test:e2e": "cucumber-js --tags \"@e2e and not @mobile\"",
    "test:mobile": "cucumber-js --tags @mobile",
    "perf:mock": "node performance/mock-api.js",
    "perf:load": "k6 run performance/load.js",
    "perf:smoke": "k6 run -e VUS=5 -e DURATION=10s -e RAMP_DURATION=1s performance/load.js",
    "mobile:download": "node mobile/download-app.js",
    "mobile:install-driver": "appium driver install uiautomator2",
    "mobile:server": "appium --address 127.0.0.1 --port 4723 --base-path /",
    "test:mobile:native": "mocha --reporter mochawesome --reporter-options reportDir=reports/mobile,reportFilename=relatorio-appium,html=true,json=true,overwrite=true --timeout 120000 \"mobile/specs/**/*.spec.js\""
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@playwright/test": "^1.65.1",
    "appium": "^4.0.0",
    "appium-uiautomator2-driver": "^9.2.2",
    "mocha": "^12.0.3",
    "mochawesome": "^8.1.1",
    "webdriverio": "^10.2.0"
  }
}
